{
  "manifest_version": 3,
  "name": "Polymarket APR",
  "version": "1.4.0",
  "description": "A simple APR calculator directly in Polymarket",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Polymarket APR",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage"],
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["https://polymarket.com/*"]
}
